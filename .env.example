# API Key de Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# Credenciales de Google (OAuth 2.0)
# Descargar desde: https://console.cloud.google.com/apis/credentials
GOOGLE_CREDENTIALS_FILE=credentials/credentials.json
GOOGLE_TOKEN_FILE=credentials/token.json

# Gmail: query para buscar postulaciones (por defecto busca emails con adjuntos no procesados)
# Ejemplo más específico: "has:attachment subject:postulacion from:@linkedin.com -label:cv-procesado"
GMAIL_QUERY=has:attachment -label:cv-procesado

# Nombre de la etiqueta que se aplica a los emails ya procesados
PROCESSED_LABEL=cv-procesado

# Nombre de la carpeta raíz en Google Drive donde se guardarán los CVs
DRIVE_FOLDER_NAME=CVs - Proceso de Selección

# ID del Google Spreadsheet existente (dejar vacío para crear uno nuevo automáticamente)
SPREADSHEET_ID=
